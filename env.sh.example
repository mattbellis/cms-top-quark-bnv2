# Copy to env.sh (gitignored) and edit. `source env.sh` before running anything.

# This repository.
export BNV2_REPO="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Scratch area where MG5 process directories are created. Needs tens of GB.
# Keep it OUTSIDE the repo, or use $BNV2_REPO/work (already in .gitignore).
export BNV2_WORK="$BNV2_REPO/work"

# MadGraph5_aMC@NLO installation (the dir containing bin/mg5_aMC).
export MG5_ROOT="$HOME/MG5_aMC_v3_7_3"

# Delphes installation (the dir containing DelphesHepMC3 and cards/).
export DELPHES_PATH="$MG5_ROOT/Delphes/"

mkdir -p "$BNV2_WORK"
